{
  "name": "pcybox-attackgraph",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pcybox/attackgraph-web dev",
    "build": "pnpm --filter @pcybox/attackgraph-web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:text": "node scripts/check-text.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "attackgraph": "node packages/cli/src/cli.ts",
    "check:content": "node packages/cli/src/cli.ts validate content/templates",
    "e2e": "pnpm --filter @pcybox/attackgraph-web e2e",
    "verify": "pnpm check:text && pnpm check:content && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
